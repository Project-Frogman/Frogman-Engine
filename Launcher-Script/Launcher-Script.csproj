<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<RootNamespace>Launcher.Script</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<WarningLevel>8</WarningLevel>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="FrogmanEngine.Launcher.ScriptInterface" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Update="FrogmanEngine.Launcher.ScriptInterface" ExcludeAssets="runtime" Version="0.0.1" />
	</ItemGroup>

</Project>
